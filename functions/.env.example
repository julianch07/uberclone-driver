# Parámetros NO secretos de las funciones (copiar a functions/.env si se
# quieren cambiar los valores por defecto). Los secretos NO van aquí.
#
# Secretos (Secret Manager), se cargan con la CLI, nunca en archivos del repo:
#   npx firebase-tools functions:secrets:set MP_ACCESS_TOKEN --project uberclone-driver-8e0bf
#   npx firebase-tools functions:secrets:set MP_WEBHOOK_SECRET --project uberclone-driver-8e0bf
# Para el emulador: functions/.secret.local con MP_ACCESS_TOKEN= y
# MP_WEBHOOK_SECRET= (archivo excluido de Git).

# init_point (recomendado) o sandbox_init_point
MP_CHECKOUT_URL_FIELD=init_point
# enforce (rechaza firmas no válidas) o report (solo las registra)
MP_WEBHOOK_SIGNATURE_MODE=enforce
# Vacío: https://us-central1-<proyecto>.cloudfunctions.net
PUBLIC_FUNCTIONS_BASE_URL=


rules_version = '2';
// AI-assisted: see docs/AI_LOG.md #10
// AI-assisted: see docs/AI_LOG.md #12
// AI-assisted: see docs/AI_LOG.md #13

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validImage(url) {
      return url is string
        && url.matches('^https://.+');
    }

    function validPersonalData(data) {
      return data is map
        && data.keys().hasAll([
          'profilePhoto', 'fullName', 'identityDocument',
          'phone', 'birthDate', 'gender', 'email', 'language'
        ])
        && validImage(data.get('profilePhoto', null))
        && data.get('fullName', null) is string && data.get('fullName', null).size() > 0
        && data.get('identityDocument', null) is string
        && data.get('phone', null) is string
        && data.get('birthDate', null) is string
        && data.get('gender', null) is string
        && data.get('email', null) is string
        && data.get('email', null).matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && data.get('language', null) is string;
    }

    function validVehicleData(data) {
      return data is map
        && data.keys().hasAll([
          'vehiclePhoto', 'category', 'plate', 'make',
          'model', 'year', 'color', 'passengerCapacity'
        ])
        && validImage(data.get('vehiclePhoto', null))
        && data.get('category', null) is string
        && data.get('plate', null) is string
        && data.get('plate', null).matches('^[A-Z]{3}[0-9]{3}$')
        && data.get('make', null) is string
        && data.get('model', null) is string
        && data.get('year', null) is string
        && data.get('color', null) is string
        && data.get('passengerCapacity', null) is string;
    }

    function validDocumentsData(data) {
      return data is map
        && data.keys().hasAll([
          'licenseNumber', 'licensePhoto', 'licenseExpiration',
          'soatPhoto', 'soatExpiration', 'mercadoPagoEmail',
          'acceptedTerms'
        ])
        && validImage(data.get('licensePhoto', null))
        && validImage(data.get('soatPhoto', null))
        && data.get('licenseNumber', null) is string
        && data.get('licenseExpiration', null) is string
        && data.get('soatExpiration', null) is string
        && data.get('mercadoPagoEmail', null) is string
        && data.get('mercadoPagoEmail', null).matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && data.get('acceptedTerms', null) == true;
    }

    function completeSections(data) {
      return data is map
        && validPersonalData(data.get('personalData', null))
        && validVehicleData(data.get('vehicleData', null))
        && validDocumentsData(data.get('documentsData', null));
    }

    function approvedAndRegistered(data) {
      return data.get('approvalStatus', null) == 'approved'
        && completeSections(data)
        && data.get('registrationCompletedAt', null) is timestamp;
    }

    // AI-assisted: see docs/AI_LOG.md #14
    // Regulariza registros antiguos sin modificar datos ni aprobación.
    function validLegacyCompletionMigration() {
      return resource.data.get('registrationCompletedAt', null) == null
        && resource.data.get('approvalStatus', null) == 'approved'
        && resource.data.get('isOnline', false) == false
        && completeSections(resource.data)
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['registrationCompletedAt'])
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasAll(['registrationCompletedAt'])
        && request.resource.data.registrationCompletedAt == request.time;
    }

    function validAvailabilityUpdate() {
      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'isOnline',
            'availabilityUpdatedAt'
          ])
        && request.resource.data.get(
          'availabilityUpdatedAt', null
        ) == request.time
        && request.resource.data.get('isOnline', null) is bool
        && (
          request.resource.data.isOnline == false
          || approvedAndRegistered(request.resource.data)
        );
    }

    function validRegistrationUpdate() {
      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'personalData',
            'vehicleData',
            'documentsData',
            'isOnline',
            'registrationCompletedAt',
            'updatedAt'
          ])
        && request.resource.data.get('isOnline', false) == false
        && completeSections(request.resource.data)
        && request.resource.data.registrationCompletedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validLegacyRegistrationUpdate() {
      return resource.data.get('approvalStatus', null) == null
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.approvalRequestedAt == request.time
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'personalData',
            'vehicleData',
            'documentsData',
            'isOnline',
            'registrationCompletedAt',
            'updatedAt',
            'approvalStatus',
            'approvalRequestedAt'
          ])
        && request.resource.data.get('isOnline', false) == false
        && completeSections(request.resource.data)
        && request.resource.data.registrationCompletedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validCoordinate(value, limit) {
      return value is number
        && value >= -limit
        && value <= limit;
    }

    // Ubicación publicada: exactamente latitud, longitud, precisión
    // (número no negativo o null) y fecha del servidor.
    function validDriverLocation(data) {
      return data.keys().hasOnly([
          'latitude', 'longitude', 'accuracy', 'updatedAt'
        ])
        && data.keys().hasAll([
          'latitude', 'longitude', 'accuracy', 'updatedAt'
        ])
        && validCoordinate(data.get('latitude', null), 90)
        && validCoordinate(data.get('longitude', null), 180)
        && (
          data.get('accuracy', null) == null
          || (data.get('accuracy', null) is number
              && data.get('accuracy', null) >= 0)
        )
        && data.get('updatedAt', null) == request.time;
    }

    // Solo se publica ubicación si el documento drivers/{uid} existe, está
    // aprobado y marcado como conectado.
    function driverIsOnline(uid) {
      return exists(/databases/$(database)/documents/drivers/$(uid))
        && get(/databases/$(database)/documents/drivers/$(uid))
            .data.get('approvalStatus', null) == 'approved'
        && get(/databases/$(database)/documents/drivers/$(uid))
            .data.get('isOnline', false) == true;
    }

    // AI-assisted: see docs/AI_LOG.md #15
    function validTripLocation(location) {
      return location is map
        && location.keys().hasAll([
          'address', 'latitude', 'longitude'
        ])
        && location.get('address', null) is string
        && location.address.size() > 0
        && validCoordinate(location.get('latitude', null), 90)
        && validCoordinate(location.get('longitude', null), 180);
    }

    // AI-assisted: see docs/AI_LOG.md #17
    function driverCanAcceptTrip(uid) {
      let driverPath = /databases/$(database)/documents/drivers/$(uid);

      // AI-assisted: see docs/AI_LOG.md #28
      // El documento se pasa como parámetro para leerlo una sola vez: las
      // variables let se evalúan en cada uso y la regla superaba el límite
      // de 1000 expresiones por petición.
      return request.auth != null
        && request.auth.uid == uid
        && exists(driverPath)
        && eligibleDriverData(get(driverPath).data);
    }

    function eligibleDriverData(driver) {
      return driver.get('approvalStatus', null) == 'approved'
        && driver.get('registrationCompletedAt', null) is timestamp
        && driver.get('personalData', null) is map
        && driver.personalData.get('fullName', null) is string
        && driver.personalData.fullName.size() > 0
        && driver.get('vehicleData', null) is map
        && driver.vehicleData.get('plate', null) is string
        && driver.vehicleData.plate.matches('^[A-Z]{3}[0-9]{3}$')
        && driver.get('documentsData', null) is map
        && driver.documentsData.get('acceptedTerms', null) == true
        && driver.get('isOnline', false) == true
        // AI-assisted: see docs/AI_LOG.md #22
        // Formato ISO 8601 de las fechas de vencimiento.
        && driver.documentsData.get('licenseExpiration', '') is string
        && driver.documentsData.get('soatExpiration', '') is string
        && driver.documentsData.licenseExpiration.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.*$')
        && driver.documentsData.soatExpiration.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.*$')
        && timestamp.value(
          driver.documentsData.licenseExpiration
        ) > request.time
        && timestamp.value(
          driver.documentsData.soatExpiration
        ) > request.time;
    }

    // AI-assisted: see docs/AI_LOG.md #23
    // Un viaje sin el campo driverId (creado manualmente en la consola) se
    // considera no asignado, igual que driverId == null. Un viaje con
    // driverId asignado sigue sin poder aceptarse.
    function validTripAcceptance(tripId) {
      // AI-assisted: see docs/AI_LOG.md #28
      // Oferta del conductor para esta solicitud (drivers/{uid}/tripOffers).
      let offerPath = /databases/$(database)/documents/drivers/$(request.auth.uid)/tripOffers/$(tripId);
      return request.auth != null
        && resource.data.get('status', null) == 'pending'
        && request.resource.data.get('status', null) == 'accepted'
        && resource.data.get('driverId', null) == null
        && validTripLocation(resource.data.get('pickup', null))
        && validTripLocation(resource.data.get('destination', null))
        && resource.data.get('estimatedFare', null) is number
        && resource.data.estimatedFare >= 0
        && request.resource.data.get('status', null) == 'accepted'
        && request.resource.data.get('driverId', null) == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status', 'driverId'])
        && driverCanAcceptTrip(request.auth.uid)
        // AI-assisted: see docs/AI_LOG.md #28
        // Solo dentro de los 15 s de la oferta (hora del servidor) y si el
        // conductor no la rechazó.
        && exists(offerPath)
        && openTripOffer(get(offerPath).data);
    }

    // AI-assisted: see docs/AI_LOG.md #28
    // Oferta vigente: sin rechazar y dentro de los 15 s desde offeredAt.
    function openTripOffer(offer) {
      return offer.get('status', null) == 'offered'
        && offer.get('offeredAt', null) is timestamp
        && request.time <= offer.offeredAt + duration.value(15, 's');
    }

    // AI-assisted: see docs/AI_LOG.md #27
    // Réplica de src/config/pricing.js y calculateFare() en
    // src/utils/fareLogic.js. Si cambian los parámetros de tarifa, deben
    // cambiarse en ambos sitios; las pruebas de reglas comparan los dos
    // cálculos. Multiplicadores en porcentaje entero: 1,0 / 1,4 / 1,8.
    function categoryMultiplierPercent(category) {
      return {
        'economy': 100,
        'xl': 140,
        'premium': 180,
        'Económico': 100,
        'XL': 140,
        'Premium': 180
      }.get(category, 0);
    }

    // Datos de recorrido válidos (distanceKm, durationMin y category).
    function hasPricingInputs(trip) {
      return trip.get('distanceKm', null) is number
        && trip.distanceKm >= 0
        && trip.distanceKm <= 1000
        && trip.get('durationMin', null) is number
        && trip.durationMin >= 0
        && trip.durationMin <= 1440
        && trip.get('category', null) is string
        && categoryMultiplierPercent(trip.category) > 0;
    }

    // Tarifa: (3.500 + km × 1.200 + min × 250) × multiplicador, redondeada
    // al múltiplo de 100 COP más cercano y con un mínimo de 6.000 COP.
    function calculatedTripFare(trip) {
      return applyMinimumFare(
        roundedTripFare(
          3500
            + math.floor(trip.distanceKm * 1200 + 0.5)
            + math.floor(trip.durationMin * 250 + 0.5),
          categoryMultiplierPercent(trip.category)
        )
      );
    }

    // AI-assisted: see docs/AI_LOG.md #28
    // Funciones auxiliares para evaluar cada valor una sola vez.
    function roundedTripFare(subtotal, multiplierPercent) {
      return math.floor((subtotal * multiplierPercent + 5000) / 10000.0) * 100;
    }

    function applyMinimumFare(fare) {
      return fare < 6000 ? 6000 : fare;
    }

    // Propina registrada en el viaje; ausente o null equivale a 0.
    function tripTip(trip) {
      return trip.get('tip', null) == null ? 0 : trip.tip;
    }

    // El desglose guardado al finalizar debe coincidir con el calculado a
    // partir del documento del viaje: el conductor no puede fijar la tarifa,
    // la comisión, su ganancia ni la propina. Sin datos de recorrido, la
    // tarifa es estimatedFare (compatibilidad con viajes anteriores).
    function validCompletionFareBreakdown(before, after) {
      // AI-assisted: see docs/AI_LOG.md #28
      return validFareBreakdownValues(
        before,
        after,
        tripTip(before),
        after.get('fare', null),
        after.get('commission', null)
      );
    }

    function validFareBreakdownValues(before, after, tip, fare, commission) {
      return tip is number
        && tip >= 0
        && math.floor(tip) == tip
        && after.get('tip', null) == tip
        && after.get('commissionRate', null) == 0.2
        && fare is number
        && (
          hasPricingInputs(before)
            ? (
              after.get('fareSource', null) == 'calculated'
              && fare == calculatedTripFare(before)
            )
            : (
              after.get('fareSource', null) == 'estimated'
              && fare == before.get('estimatedFare', null)
            )
        )
        && commission == math.floor(fare * 20 / 100.0 + 0.5)
        && after.get('driverEarnings', null) == fare - commission + tip;
    }

    // AI-assisted: see docs/AI_LOG.md #17
    // AI-assisted: see docs/AI_LOG.md #28
    // Ciclo del viaje asignado (solo el conductor asignado):
    //   accepted → driver_arriving              (arrivingAt: "Voy en camino")
    //   driver_arriving → driver_arriving       (arrivedAt: "Llegué al origen")
    //   driver_arriving con arrivedAt → in_progress (startedAt: "Pasajero a bordo")
    //   in_progress → completed                 (completedAt + desglose, #27)
    //   accepted | driver_arriving → cancelled  (cancelledAt)
    // Ningún otro campo puede cambiar: tarifa, distancia, duración, categoría,
    // propina, método o estado de pago quedan protegidos.
    function validTripLifecycleTransition() {
      return validLifecycleChange(
        resource.data,
        request.resource.data,
        resource.data.get('status', null),
        request.resource.data.get('status', null),
        request.resource.data.diff(resource.data).affectedKeys()
      );
    }

    function validLifecycleChange(before, after, from, to, changed) {
      // AI-assisted: see docs/AI_LOG.md #28
      // El motor de reglas no cortocircuita && ni ||: evalúa todas las
      // ramas. Se despacha con ?:, que solo evalúa la rama elegida, para no
      // superar el límite de 1000 expresiones por petición.
      return request.auth != null
        && from in ['accepted', 'driver_arriving', 'in_progress']
        && before.get('driverId', null) == request.auth.uid
        && validTripLocation(before.get('pickup', null))
        && validTripLocation(before.get('destination', null))
        && before.get('estimatedFare', null) is number
        && before.estimatedFare >= 0
        && after.get('driverId', null) == before.get('driverId', null)
        && (
          from == 'accepted'
            ? validAcceptedTripChange(before, after, to, changed)
            : from == 'driver_arriving'
              ? validArrivingTripChange(before, after, to, changed)
              : validInProgressTripChange(before, after, to, changed)
        );
    }

    // accepted → driver_arriving ("Voy en camino") o → cancelled.
    function validAcceptedTripChange(before, after, to, changed) {
      return to == 'driver_arriving'
        ? before.get('arrivingAt', null) == null
          && after.get('arrivingAt', null) == request.time
          && changed.hasOnly(['status', 'arrivingAt'])
        : to == 'cancelled' && validTripCancellation(before, after, changed);
    }

    // driver_arriving → arrivedAt ("Llegué al origen"),
    // → in_progress ("Pasajero a bordo", solo con arrivedAt) o → cancelled.
    function validArrivingTripChange(before, after, to, changed) {
      return to == 'driver_arriving'
        ? before.get('arrivedAt', null) == null
          && after.get('arrivedAt', null) == request.time
          && changed.hasOnly(['arrivedAt'])
        : to == 'in_progress'
          ? before.get('arrivedAt', null) is timestamp
            && before.get('startedAt', null) == null
            && after.get('startedAt', null) == request.time
            && changed.hasOnly(['status', 'startedAt'])
          : to == 'cancelled' && validTripCancellation(before, after, changed);
    }

    // in_progress → completed con el desglose de tarifa (#27).
    function validInProgressTripChange(before, after, to, changed) {
      return to == 'completed'
        && before.get('completedAt', null) == null
        && after.get('completedAt', null) == request.time
        // AI-assisted: see docs/AI_LOG.md #27
        && changed.hasOnly([
          'status', 'completedAt', 'fare', 'commission',
          'commissionRate', 'driverEarnings', 'tip', 'fareSource'
        ])
        && validCompletionFareBreakdown(before, after);
    }

    function validTripCancellation(before, after, changed) {
      return before.get('cancelledAt', null) == null
        && after.get('cancelledAt', null) == request.time
        && changed.hasOnly(['status', 'cancelledAt']);
    }

    match /trips/{tripId} {
      allow create, delete: if false;

      allow get: if request.auth != null
        && (
          resource.data.get('driverId', null) == request.auth.uid
          || (
            resource.data.get('status', null) == 'pending'
            && driverCanAcceptTrip(request.auth.uid)
          )
        );

      // AI-assisted: see docs/AI_LOG.md #18
      allow list: if request.auth != null
        && request.query.limit != null
        && (
          (
            driverCanAcceptTrip(request.auth.uid)
            && resource.data.get('status', null) == 'pending'
            && request.query.limit <= 20
          )
          || (
            resource.data.get('driverId', null) == request.auth.uid
            // AI-assisted: see docs/AI_LOG.md #28
            && resource.data.get('status', null) in [
              'accepted', 'driver_arriving', 'in_progress'
            ]
            && request.query.limit <= 2
          )
          // AI-assisted: see docs/AI_LOG.md #23
          // Historial, ganancias y pagos: solo viajes finalizados propios,
          // máximo 50 por consulta. No exige estar conectado.
          || (
            resource.data.get('driverId', null) == request.auth.uid
            && resource.data.get('status', null) in [
              'completed', 'cancelled'
            ]
            && request.query.limit <= 50
          )
        );

      // AI-assisted: see docs/AI_LOG.md #17
      // AI-assisted: see docs/AI_LOG.md #28
      // Una sola regla de actualización despachada con ?: según el estado
      // actual: así solo se evalúa la aceptación o el ciclo de vida, y no
      // ambas (el motor no cortocircuita && ni || y el límite de 1000
      // expresiones es por petición).
      allow update: if request.auth != null
        && (
          resource.data.get('status', null) == 'pending'
            ? request.resource.data.get('status', null) == 'accepted'
              && validTripAcceptance(tripId)
            : resource.data.get('status', null) in [
                'accepted', 'driver_arriving', 'in_progress'
              ]
              && validTripLifecycleTransition()
        );
    }

    match /driverLocations/{uid} {

      // Privada: solo su propietario puede leerla.
      allow read: if isOwner(uid);

      allow create, update: if isOwner(uid)
        && driverIsOnline(uid)
        && validDriverLocation(request.resource.data);

      // El propietario puede borrar su propia ubicación al desconectarse.
      allow delete: if isOwner(uid);
    }

    // AI-assisted: see docs/AI_LOG.md #28
    // Solicitud abierta: pendiente y sin conductor asignado.
    function tripRequestOpen(tripId) {
      let tripPath = /databases/$(database)/documents/trips/$(tripId);
      return exists(tripPath)
        && get(tripPath).data.get('status', null) == 'pending'
        && get(tripPath).data.get('driverId', null) == null;
    }

    // Ofertas de solicitudes por conductor. La oferta registra con la hora
    // del servidor cuándo recibió el conductor la solicitud; el plazo de
    // 15 s se cuenta desde offeredAt y no puede reiniciarse (no se permite
    // recrear ni modificar offeredAt). El rechazo solo afecta a ese
    // conductor; el vencimiento se verifica con request.time.
    match /drivers/{uid}/tripOffers/{tripId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'tripId', 'status', 'offeredAt'
        ])
        && request.resource.data.keys().hasAll([
          'tripId', 'status', 'offeredAt'
        ])
        && request.resource.data.tripId == tripId
        && request.resource.data.status == 'offered'
        && request.resource.data.offeredAt == request.time
        && tripRequestOpen(tripId)
        && driverCanAcceptTrip(uid);

      allow update: if isOwner(uid)
        && resource.data.get('status', null) == 'offered'
        && request.resource.data.get('status', null) == 'rejected'
        && request.resource.data.get('reason', null) in ['manual', 'expired']
        && request.resource.data.get('respondedAt', null) == request.time
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status', 'reason', 'respondedAt'])
        && (
          request.resource.data.reason == 'manual'
          || request.time > resource.data.offeredAt + duration.value(15, 's')
        );

      allow delete: if false;
    }

    match /drivers/{uid} {

      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'personalData',
          'vehicleData',
          'documentsData',
          'isOnline',
          'registrationCompletedAt',
          'approvalStatus',
          'approvalRequestedAt',
          'updatedAt'
        ])
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.approvalRequestedAt == request.time
        && request.resource.data.isOnline == false
        && completeSections(request.resource.data)
        && request.resource.data.registrationCompletedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid)
        && (
          resource.data.get('approvalStatus', null) == null
            ? validLegacyRegistrationUpdate()
            : (
                request.resource.data.approvalStatus
                  == resource.data.approvalStatus
                && (
                  validAvailabilityUpdate()
                  || validRegistrationUpdate()
                  || validLegacyCompletionMigration()
                )
              )
        );

      allow delete: if false;
    }
  }
}
